<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!-- Production: Varsayılan olarak cleartext'e izin verme -->
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
    <!-- TMDB ve Firebase gibi tüm API'lar HTTPS kullanır, cleartext gerekmez -->
</network-security-config>